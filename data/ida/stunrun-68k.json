    {"ea": "0x600000", "kind": "repeatable", "text": "JSA II, high byte: read the sound CPU's response, write a command"},
    {"ea": "0x604000", "kind": "repeatable", "text": "read: reset the sound board; write: NWR_LATCH (A0-A2 line, A3 value)"},
    {"ea": "0x608000", "kind": "repeatable", "text": "write: kick the watchdog"},
    {"ea": "0x60C000", "kind": "repeatable", "text": "read: port 0 (DIAGN, sync, EOC, self-test, coins, DIP SW1); write: IRQ5_ACK"},
    {"ea": "0x800000", "kind": "repeatable", "text": "ADSP program RAM, 8K x 24-bit words as 32-bit pairs"},
    {"ea": "0x808000", "kind": "repeatable", "text": "ADSP data RAM, 8K x 16; a write to word 0x1FFF raises the ADSP IRQ"},
    {"ea": "0x810000", "kind": "repeatable", "text": "ADSP output buffer (SOM), bank from ADSP_CONTROL line 3"},
    {"ea": "0x818000", "kind": "repeatable", "text": "write: A0-A2 line, bit 3 value; 0-1 LEDs, 3 bank, 5 /BR, 6 /HALT, 7 reset"},
    {"ea": "0x818060", "kind": "repeatable", "text": "write: clear the ADSP interrupt (level 2)"},
    {"ea": "0x838000", "kind": "repeatable", "text": "read: bit 0 low = ADSP IRQ pending, bit 1 low = XFLAG"},
    {"ea": "0xA00000", "kind": "repeatable", "text": "write: A0-A2 line, bit 3 value; 1-4 SEL1-SEL4, 6-7 coin counters"},
    {"ea": "0xA80000", "kind": "repeatable", "text": "read: bit 0 button 1, bit 1 button 2, bit 2 start; write: WR1_LATCH"},
    {"ea": "0xB00000", "kind": "repeatable", "text": "read, odd byte: ADC0809 result (ch 0 stick X, ch 2 stick Y); write: WR2_LATCH"},
    {"ea": "0xB80000", "kind": "repeatable", "text": "12-bit ADC: read the result, write the channel select and start"},
    {"ea": "0xC00000", "kind": "repeatable", "text": "TMS34010 host interface (HSTADRL/HSTADRH/HSTDATA/HSTCTL, swapped in pairs)"},
    {"ea": "0xC04000", "kind": "repeatable", "text": "MSP host interface, reads 0xFFFF (no MSP on this board)"},
    {"ea": "0xFF0000", "kind": "repeatable", "text": "MC68681 DUART, high byte"}
  ],
